{
  "name": "paceboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "DATABASE_URL=postgresql://paceboard:paceboard@localhost:5432/paceboard_test vitest run",
    "db:migrate": "prisma migrate dev",
    "db:test:push": "DATABASE_URL=postgresql://paceboard:paceboard@localhost:5432/paceboard_test prisma db push",
    "verify": "npm run test && npm run build"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "fast-xml-parser": "5.11.2",
    "leaflet": "1.9.4",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "5.0.0",
    "recharts": "3.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "postcss": "8.5.31",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.5"
  }
}
